#!/usr/bin/make -f

# See debhelper(7) (uncomment to enable).
# Output every command that modifies files on the build system.
#export DH_VERBOSE = 1


%:
	dh $@


# Both frontends and the common files are built and staged per binary package
# by build2_welcome.sh, as q4os-cpuq and q4os-sw-profiler do it. There is no
# build system at the top level, so dh_auto_* find nothing to do.
override_dh_install:
	dh_install
	dash build2_welcome.sh
